# Copy to .env; replace the password locally. Never commit .env.
POSTGRES_USER=card_engine
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=card_engine
# For host development, percent-encode special characters in URL credentials.
DATABASE_URL=postgresql://card_engine:replace-with-a-long-random-password@localhost:5432/card_engine
APP_ORIGIN=http://localhost:3000
# Set true behind HTTPS in production; local HTTP needs false.
COOKIE_SECURE=false
# Optional: database connections per server process (default 10). On serverless
# hosting such as Vercel with Neon's pooled connection, use 3 (docs/deployment/vercel-neon.md).
DATABASE_POOL_MAX=

# Optional public HTTPS profile (infra/docker/compose.https.yaml).
# Keep blank for localhost. On the host, set APP_ORIGIN=https://this-hostname and COOKIE_SECURE=true.
PUBLIC_HOSTNAME=

# Discord sign-in, the main login (docs/deployment/quickstart.md, step 2).
# Left blank, only local email/password accounts work.
# Register APP_ORIGIN + /api/auth/discord/callback in Discord's OAuth2 settings.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your Discord USER ID (not username or application ID). Bootstraps only if no admin exists.
DISCORD_ADMIN_USER_ID=

# Optional signed Discord gameplay HTTP endpoint. Public key from General Information.
# Leave blank to disable /api/discord/interactions; local gameplay and OAuth still work.
DISCORD_PUBLIC_KEY=

# Optional scheduled backups; used only with infra/docker/compose.backups.yaml or backup:*.
# Absolute paths OUTSIDE this repository. Prepare and initialize the destination first.
# A mounted remote drive is supported; a second local folder alone is not offsite protection.
BACKUP_POLICY_VERSION=1
BACKUP_INSTANCE_ID=main
BACKUP_DIRECTORY=
# Separate private file containing a 16-256 character passphrase, never inside the backup folder.
BACKUP_PASSPHRASE_FILE=
BACKUP_HOUR_UTC=3
BACKUP_RETAIN_DAILY=7
BACKUP_RETAIN_WEEKLY=4

# Optional restore drills. The Compose overlay uses a separate disposable PostgreSQL service.
# Set a DIFFERENT long URL-safe password locally before enabling the overlay.
RESTORE_CHECK_PASSWORD=
RESTORE_CHECK_POLICY_VERSION=1
# Weekly day: 0=Sunday, 1=Monday, ... 6=Saturday; all scheduling is UTC.
RESTORE_CHECK_DAY_UTC=1
RESTORE_CHECK_HOUR_UTC=4
RESTORE_CHECK_MAX_BACKUP_AGE_HOURS=36
# Host-only alternative: dedicated PostgreSQL instance, database name must match exactly.
# Never point this at your game database. The Docker overlay supplies its own URL.
RESTORE_CHECK_DATABASE_URL=

# Optional encrypted offsite copies. Prepare a private S3-compatible bucket yourself.
# No ambient AWS credentials are used; this private JSON file stays outside the repo/backups.
BACKUP_REMOTE_POLICY_VERSION=1
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_CREDENTIALS_FILE=
BACKUP_REMOTE_MAX_BYTES=67108864
# Optional backup alerts. Disabled unless a monitor is started explicitly.
# Receiver file JSON: {"schemaVersion":1,"url":"https://receiver.example/hook","token":"private-bearer-token"}
BACKUP_ALERT_POLICY_VERSION=1
BACKUP_ALERT_CHECKS=capture
BACKUP_ALERT_STATE_DIRECTORY=
BACKUP_ALERT_WEBHOOK_FILE=
