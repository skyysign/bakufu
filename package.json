{
  "name": "card-engine",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @card-engine/web dev",
    "build": "pnpm --filter @card-engine/web build",
    "start": "pnpm --filter @card-engine/web start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm --filter @card-engine/web typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:backup-docker": "tsx scripts/backup-docker.ts",
    "test:https-docker": "tsx scripts/https-docker.ts",
    "deployment:check": "tsx --env-file-if-exists=.env scripts/deployment-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "bootstrap": "tsx --env-file-if-exists=.env scripts/accounts.ts bootstrap",
    "player:create": "tsx --env-file-if-exists=.env scripts/accounts.ts player",
    "discord:link": "tsx --env-file-if-exists=.env scripts/discord-link.ts",
    "discord:commands": "tsx --env-file-if-exists=.env scripts/discord-commands.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts backup",
    "backup:init": "tsx --env-file-if-exists=.env apps/worker/src/main.ts init",
    "backup:run": "tsx --env-file-if-exists=.env apps/worker/src/main.ts once",
    "backup:worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts serve",
    "backup:status": "tsx --env-file-if-exists=.env apps/worker/src/main.ts status",
    "backup:verify:init": "tsx --env-file-if-exists=.env apps/worker/src/restore-main.ts init",
    "backup:verify": "tsx --env-file-if-exists=.env apps/worker/src/restore-main.ts once",
    "backup:verify:worker": "tsx --env-file-if-exists=.env apps/worker/src/restore-main.ts serve",
    "backup:verify:status": "tsx --env-file-if-exists=.env apps/worker/src/restore-main.ts status",
    "backup:remote:init": "tsx --env-file-if-exists=.env apps/worker/src/remote-main.ts init",
    "backup:remote": "tsx --env-file-if-exists=.env apps/worker/src/remote-main.ts once",
    "backup:remote:worker": "tsx --env-file-if-exists=.env apps/worker/src/remote-main.ts serve",
    "backup:remote:status": "tsx --env-file-if-exists=.env apps/worker/src/remote-main.ts status",
    "backup:remote:fetch": "tsx --env-file-if-exists=.env apps/worker/src/remote-main.ts fetch",
    "restore": "tsx --env-file-if-exists=.env scripts/backup.ts restore",
    "backup:monitor:init": "tsx --env-file-if-exists=.env apps/worker/src/monitor-main.ts init",
    "backup:monitor": "tsx --env-file-if-exists=.env apps/worker/src/monitor-main.ts once",
    "backup:monitor:worker": "tsx --env-file-if-exists=.env apps/worker/src/monitor-main.ts serve",
    "backup:monitor:status": "tsx --env-file-if-exists=.env apps/worker/src/monitor-main.ts status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "pg": "^8.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
